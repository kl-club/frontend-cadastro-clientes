{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preapi": "node -e \"const fs=require('fs');fs.existsSync('db.json')||fs.copyFileSync('db.example.json','db.json')\"",
    "api": "json-server --watch db.json --port 3001",
    "dev:all": "concurrently -k \"npm:api\" \"npm:dev\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "axios": "^1.7.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "concurrently": "^8.2.2",
    "json-server": "0.17.4"
  }
}
